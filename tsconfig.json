{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TypeScript 6+ no longer auto-includes every package in
    // node_modules/@types, so ambient globals like `jest` and
    // `NodeJS.Timeout` must be listed explicitly.
    "types": ["jest", "node"]
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}
